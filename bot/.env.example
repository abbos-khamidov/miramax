DATABASE_URL=postgresql+asyncpg://miramax:miramax@db:5432/miramax
DATABASE_URL_SYNC=postgresql+psycopg2://miramax:miramax@db:5432/miramax
POSTGRES_USER=miramax
POSTGRES_PASSWORD=miramax
POSTGRES_DB=miramax

BOT_TOKEN=123456:REPLACE_ME
BOT_USERNAME=miramax_bonus_bot
# Separate bot + token, only for factory/admin — fully independent from the bot above,
# no shared menu/commands. Suppliers/sellers/customers never talk to this bot.
ADMIN_BOT_TOKEN=123456:REPLACE_ME_TOO
ADMIN_BOT_USERNAME=miramax_bonus_admin_bot
# Third bot: supplier + seller together (role-routed inside), separate from admin/client bots.
SELLER_BOT_TOKEN=123456:REPLACE_ME_THREE
SELLER_BOT_USERNAME=miramax_bonus_seller_bot
# Optional HTTP proxy, when api.telegram.org is blocked from the host/network.
# Example from Docker Desktop/Colima to a local proxy on the Mac: http://host.docker.internal:7890
TELEGRAM_PROXY_URL=

# Base URL where the Mini App is served (must be https for Telegram to open it;
# use an ngrok/cloudflared tunnel URL during local dev, real domain after VPS deploy)
MINIAPP_URL=https://example.ngrok-free.app

# Base URL where the Factory admin web app (admin-webapp/) is served — same rules as
# MINIAPP_URL above (must be https; tunnel it locally, real domain once deployed).
ADMIN_WEBAPP_URL=https://example.ngrok-free.app

# Backend URL as seen by the bot/miniapp (http is fine for server-to-server calls)
BACKEND_URL=http://backend:8000

# telegram_id values used by seed.py to bootstrap the first factory + supplier accounts
SEED_FACTORY_TELEGRAM_ID=000000001
SEED_SUPPLIER_TELEGRAM_ID=000000002
SEED_SUPPLIER_NAME=Test Supplier LLC
